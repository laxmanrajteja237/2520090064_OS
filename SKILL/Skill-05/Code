#include <stdio.h>
#include <string.h>
#include <ctype.h>

#define MAX_TOKENS 100
#define MAX_LENGTH 50

typedef struct {
    char type[20];
    char value[MAX_LENGTH];
} Token;

Token tokens[MAX_TOKENS];
int token_count = 0;

/* ---------------- TOKENIZER ---------------- */

void tokenize(char input[]) {
    int i = 0;

    while (input[i] != '\0') {

        /* Handle whitespace */
        if (isspace(input[i])) {
            i++;
            continue;
        }

        /* Identify words */
        if (isalnum(input[i]) || input[i] == '_') {
            int j = 0;

            strcpy(tokens[token_count].type, "WORD");

            while (isalnum(input[i]) || input[i] == '_') {
                if (j < MAX_LENGTH - 1) {
                    tokens[token_count].value[j++] = input[i];
                }
                i++;
            }

            tokens[token_count].value[j] = '\0';
            token_count++;
        }

        /* Identify delimiters/operators */
        else if (input[i] == '|' ||
                 input[i] == '>' ||
                 input[i] == '<' ||
                 input[i] == '&' ||
                 input[i] == ';') {

            strcpy(tokens[token_count].type, "DELIMITER");

            tokens[token_count].value[0] = input[i];
            tokens[token_count].value[1] = '\0';

            token_count++;
            i++;
        }

        /* Unknown character */
        else {
            printf("Lexical Error: Unknown character '%c'\n",
                   input[i]);
            i++;
        }

        if (token_count >= MAX_TOKENS) {
            printf("Error: Too many tokens.\n");
            break;
        }
    }
}

/* ---------------- DISPLAY TOKENS ---------------- */

void display_tokens() {
    int i;

    printf("\n========== TOKEN STREAM ==========\n");

    if (token_count == 0) {
        printf("No tokens found.\n");
        return;
    }

    for (i = 0; i < token_count; i++) {
        printf("Token %d : Type = %-10s Value = %s\n",
               i + 1,
               tokens[i].type,
               tokens[i].value);
    }
}

/* ---------------- PARSER ---------------- */

void parse() {
    int i;

    printf("\n========== PARSER OUTPUT ==========\n");

    /* Empty command */
    if (token_count == 0) {
        printf("Empty command.\n");
        printf("Nothing to execute.\n");
        return;
    }

    /* First token must be a WORD */
    if (strcmp(tokens[0].type, "WORD") != 0) {
        printf("Syntax Error: Command expected at beginning.\n");
        return;
    }

    printf("Parse Tree:\n");
    printf("COMMAND\n");
    printf("  |\n");
    printf("  +-- %s\n", tokens[0].value);

    /* Check remaining tokens */
    for (i = 1; i < token_count; i++) {

        if (strcmp(tokens[i].type, "WORD") == 0) {
            printf("      +-- ARGUMENT: %s\n",
                   tokens[i].value);
        }

        else if (strcmp(tokens[i].value, "|") == 0) {

            printf("      +-- PIPE |\n");

            /* Validate pipe */
            if (i == token_count - 1 ||
                strcmp(tokens[i + 1].type, "WORD") != 0) {

                printf("Syntax Error: Command expected after '|'.\n");
                return;
            }
        }

        else if (strcmp(tokens[i].value, ">") == 0) {

            printf("      +-- OUTPUT REDIRECTION >\n");

            if (i == token_count - 1 ||
                strcmp(tokens[i + 1].type, "WORD") != 0) {

                printf("Syntax Error: Filename expected after '>'.\n");
                return;
            }
        }

        else if (strcmp(tokens[i].value, "<") == 0) {

            printf("      +-- INPUT REDIRECTION <\n");

            if (i == token_count - 1 ||
                strcmp(tokens[i + 1].type, "WORD") != 0) {

                printf("Syntax Error: Filename expected after '<'.\n");
                return;
            }
        }

        else if (strcmp(tokens[i].value, "&") == 0) {
            printf("      +-- BACKGROUND &\n");
        }

        else if (strcmp(tokens[i].value, ";") == 0) {
            printf("      +-- COMMAND SEPARATOR ;\n");
        }
    }

    printf("\nSyntax Validation: SUCCESS\n");
    printf("Execution structure generated successfully.\n");
}

/* ---------------- MAIN ---------------- */

int main() {
    char input[500];

    printf("========================================\n");
    printf("       SIMPLE COMMAND TOKENIZER\n");
    printf("          AND PARSER IN C\n");
    printf("========================================\n");

    printf("\nEnter a command: ");

    if (fgets(input, sizeof(input), stdin) == NULL) {
        printf("Input error.\n");
        return 1;
    }

    /* Remove newline */
    input[strcspn(input, "\n")] = '\0';

    /* Tokenize input */
    tokenize(input);

    /* Display token stream */
    display_tokens();

    /* Parse token stream */
    parse();

    return 0;
}
