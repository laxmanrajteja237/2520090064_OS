#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <ctype.h>

#define MAX_TOKENS 100
#define MAX_LENGTH 200

typedef struct {
    char type[20];
    char value[MAX_LENGTH];
} Token;

Token tokens[MAX_TOKENS];
int token_count = 0;

/* Expand environment variables in double quotes */
void expand_variable(char *input, char *output) {
    int i = 0;
    int j = 0;

    while (input[i] != '\0' && j < MAX_LENGTH - 1) {

        if (input[i] == '$') {
            char variable[100];
            int k = 0;
            i++;

            /* Read variable name */
            while ((isalnum(input[i]) || input[i] == '_') &&
                   k < 99) {
                variable[k++] = input[i++];
            }

            variable[k] = '\0';

            char *value = getenv(variable);

            if (value != NULL) {
                int x = 0;

                while (value[x] != '\0' &&
                       j < MAX_LENGTH - 1) {
                    output[j++] = value[x++];
                }
            }
        }
        else {
            output[j++] = input[i++];
        }
    }

    output[j] = '\0';
}

/* Add token */
void add_token(const char *type, const char *value) {

    if (token_count >= MAX_TOKENS) {
        printf("Error: Too many tokens.\n");
        return;
    }

    strcpy(tokens[token_count].type, type);
    strncpy(tokens[token_count].value,
            value,
            MAX_LENGTH - 1);

    tokens[token_count].value[MAX_LENGTH - 1] = '\0';

    token_count++;
}

/* Tokenizer with quote handling */
int tokenize(char *input) {

    int i = 0;

    while (input[i] != '\0') {

        /* Ignore whitespace outside quotes */
        if (isspace(input[i])) {
            i++;
            continue;
        }

        /* SINGLE QUOTES */
        if (input[i] == '\'') {

            char buffer[MAX_LENGTH];
            int j = 0;

            i++;

            while (input[i] != '\0' &&
                   input[i] != '\'') {

                if (j < MAX_LENGTH - 1) {
                    buffer[j++] = input[i];
                }

                i++;
            }

            buffer[j] = '\0';

            /* Check closing quote */
            if (input[i] != '\'') {
                printf("\nSyntax Error: Unclosed single quote.\n");
                return 0;
            }

            i++;

            add_token("SINGLE_QUOTE", buffer);
        }

        /* DOUBLE QUOTES */
        else if (input[i] == '"') {

            char buffer[MAX_LENGTH];
            char expanded[MAX_LENGTH];
            int j = 0;

            i++;

            while (input[i] != '\0' &&
                   input[i] != '"') {

                if (j < MAX_LENGTH - 1) {
                    buffer[j++] = input[i];
                }

                i++;
            }

            buffer[j] = '\0';

            /* Check closing quote */
            if (input[i] != '"') {
                printf("\nSyntax Error: Unclosed double quote.\n");
                return 0;
            }

            i++;

            /* Expand variables */
            expand_variable(buffer, expanded);

            add_token("DOUBLE_QUOTE", expanded);
        }

        /* NORMAL WORD */
        else {

            char buffer[MAX_LENGTH];
            int j = 0;

            while (input[i] != '\0' &&
                   !isspace(input[i]) &&
                   input[i] != '\'' &&
                   input[i] != '"') {

                if (j < MAX_LENGTH - 1) {
                    buffer[j++] = input[i];
                }

                i++;
            }

            buffer[j] = '\0';

            add_token("WORD", buffer);
        }
    }

    return 1;
}

/* Display tokens */
void display_tokens() {

    printf("\n========== TOKEN STREAM ==========\n");

    if (token_count == 0) {
        printf("No tokens found.\n");
        return;
    }

    for (int i = 0; i < token_count; i++) {

        printf("Token %d:\n", i + 1);
        printf("  Type  : %s\n",
               tokens[i].type);
        printf("  Value : %s\n",
               tokens[i].value);
    }
}

/* Validate parser output */
void validate() {

    printf("\n========== PARSER VALIDATION ==========\n");

    if (token_count == 0) {
        printf("Empty command.\n");
        return;
    }

    printf("Parsing successful.\n");
    printf("Total tokens: %d\n", token_count);

    printf("\nExecution Structure:\n");

    for (int i = 0; i < token_count; i++) {

        if (strcmp(tokens[i].type,
                   "SINGLE_QUOTE") == 0) {

            printf("Argument %d: '%s'\n",
                   i + 1,
                   tokens[i].value);
        }

        else if (strcmp(tokens[i].type,
                        "DOUBLE_QUOTE") == 0) {

            printf("Argument %d: \"%s\"\n",
                   i + 1,
                   tokens[i].value);
        }

        else {

            printf("Argument %d: %s\n",
                   i + 1,
                   tokens[i].value);
        }
    }
}

/* Main */
int main() {

    char input[500];

    printf("============================================\n");
    printf("       QUOTED COMMAND PARSER IN C\n");
    printf("============================================\n");

    printf("\nSingle quotes  : Literal content\n");
    printf("Double quotes  : Spaces + variable expansion\n");

    printf("\nEnter command: ");

    if (fgets(input, sizeof(input), stdin) == NULL) {
        printf("Input error.\n");
        return 1;
    }

    /* Remove newline */
    input[strcspn(input, "\n")] = '\0';

    /* Tokenize */
    if (!tokenize(input)) {
        return 1;
    }

    /* Display tokens */
    display_tokens();

    /* Validate */
    validate();

    return 0;
}
