#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define INITIAL_SIZE 32
#define MAX_HISTORY 10

/* Linked list node */
typedef struct Node {
    char *command;
    struct Node *next;
} Node;

/* Add command to linked list */
void add_to_list(Node **head, const char *command)
{
    Node *new_node = malloc(sizeof(Node));

    if (new_node == NULL) {
        printf("Memory allocation failed!\n");
        return;
    }

    new_node->command = malloc(strlen(command) + 1);

    if (new_node->command == NULL) {
        free(new_node);
        printf("Memory allocation failed!\n");
        return;
    }

    strcpy(new_node->command, command);
    new_node->next = *head;
    *head = new_node;
}

/* Display linked list */
void display_list(Node *head)
{
    printf("\nCommand History:\n");

    int number = 1;

    while (head != NULL) {
        printf("%d. %s\n", number, head->command);
        head = head->next;
        number++;
    }
}

/* Free linked list */
void free_list(Node *head)
{
    Node *temp;

    while (head != NULL) {
        temp = head;
        head = head->next;

        free(temp->command);
        free(temp);
    }
}

/* Read input using dynamically growing buffer */
char *read_dynamic_input(void)
{
    size_t size = INITIAL_SIZE;
    size_t length = 0;

    char *buffer = malloc(size);

    if (buffer == NULL) {
        printf("Memory allocation failed!\n");
        return NULL;
    }

    int ch;

    while ((ch = getchar()) != '\n' && ch != EOF) {

        /* Prevent buffer overflow by resizing */
        if (length + 1 >= size) {
            size *= 2;

            char *temp = realloc(buffer, size);

            if (temp == NULL) {
                free(buffer);
                printf("Memory reallocation failed!\n");
                return NULL;
            }

            buffer = temp;
        }

        buffer[length++] = (char)ch;
    }

    buffer[length] = '\0';

    return buffer;
}

int main(void)
{
    Node *history = NULL;

    char *commands[MAX_HISTORY];

    int command_count = 0;
    int current = -1;

    printf("=====================================\n");
    printf(" Dynamic Command History System\n");
    printf("=====================================\n");

    printf("\nEscape Sequences Demo:\n");
    printf("Hello\nWorld\n");
    printf("Name:\tLaxman\n");
    printf("Backspace Demo: ABC\b \n");

    printf("\nEnter commands.\n");
    printf("Type 'history' to view history.\n");
    printf("Type 'previous' to recall previous command.\n");
    printf("Type 'next' to move to next command.\n");
    printf("Type 'exit' to quit.\n\n");

    while (1) {

        printf("shell> ");

        char *input = read_dynamic_input();

        if (input == NULL)
            break;

        /* Exit */
        if (strcmp(input, "exit") == 0) {
            free(input);
            break;
        }

        /* Display history */
        if (strcmp(input, "history") == 0) {
            display_list(history);
            free(input);
            continue;
        }

        /* Previous command */
        if (strcmp(input, "previous") == 0) {

            if (command_count == 0) {
                printf("No previous command available.\n");
            } else {
                if (current == -1)
                    current = command_count - 1;
                else if (current > 0)
                    current--;

                printf("Recalled command: %s\n", commands[current]);
            }

            free(input);
            continue;
        }

        /* Next command */
        if (strcmp(input, "next") == 0) {

            if (command_count == 0) {
                printf("No command available.\n");
            } else if (current == -1 || current >= command_count - 1) {
                printf("No next command available.\n");
            } else {
                current++;
                printf("Next command: %s\n", commands[current]);
            }

            free(input);
            continue;
        }

        /* Store command in history */
        if (command_count < MAX_HISTORY) {

            commands[command_count] = malloc(strlen(input) + 1);

            if (commands[command_count] == NULL) {
                printf("Memory allocation failed!\n");
                free(input);
                break;
            }

            strcpy(commands[command_count], input);

            add_to_list(&history, input);

            command_count++;

        } else {
            printf("History is full. Maximum %d commands.\n",
                   MAX_HISTORY);
        }

        current = -1;

        printf("Command stored: %s\n", input);

        free(input);
    }

    /* Free command history array */
    for (int i = 0; i < command_count; i++) {
        free(commands[i]);
    }

    /* Free linked list */
    free_list(history);

    printf("\nAll allocated memory has been released.\n");
    printf("Program terminated successfully.\n");

    return 0;
}
